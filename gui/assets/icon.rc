// Windows resources for the GUI: the application icon Explorer and the taskbar
// show, plus the version block that the file properties dialog reads.

1 ICON "resdhlt.ico"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          0x4L      // VOS__WINDOWS32
FILETYPE        0x1L      // VFT_APP
{
    BLOCK "StringFileInfo"
    {
        BLOCK "080904B0"   // English (UK) / Unicode: the neutral choice
        {
            VALUE "CompanyName",      "ReSDHLT"
            VALUE "FileDescription",  "ReSDHLT - compilador de mapas para CS 1.6"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "resdhlt-gui"
            VALUE "LegalCopyright",   "GPL-2.0-or-later"
            VALUE "OriginalFilename", "resdhlt-gui.exe"
            VALUE "ProductName",      "ReSDHLT"
            VALUE "ProductVersion",   "0.1.0"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x809, 1200
    }
}
